# Obtain these from OpenAI Platform > Settings > Organization > Tunnels / API Keys.
CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_your_tunnel_id
CONTROL_PLANE_API_KEY=sk-replace_with_your_runtime_api_key

# Choose an unused host-local OAuth callback port (fixed for both auth and tunnel).
OAUTH_CALLBACK_PORT=38677
