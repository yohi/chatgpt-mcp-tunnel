# AWS MCP uses a NEW OpenAI Tunnel and a runtime-use API key.
# DO NOT reuse the Atlassian tunnel ID or copy tokens between their containers.
AWS_CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_aws_tunnel_id
AWS_CONTROL_PLANE_API_KEY=sk-replace_with_runtime_key

# Region hosting the managed MCP endpoint and SigV4 signature.
AWS_MCP_ENDPOINT_REGION=ap-northeast-1
# Default region for the AWS APIs called by the managed MCP server.
AWS_MCP_TARGET_REGION=ap-northeast-1
# AWS CLI image from the official AWS Docker Hub repo. Avoid ECR Public
# unauthenticated image-pull throttling; pinned version tag, not latest.
AWS_CLI_IMAGE=amazon/aws-cli:2.37.12

# Detailed diagnostics now run only inside the AWS container via exec.
# Host port 18081 is NOT published; AWS_HEALTH_PORT is no longer used.
