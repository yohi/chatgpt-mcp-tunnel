# Create a dedicated OpenAI Platform Tunnel for the Filesystem MCP service.
FILESYSTEM_CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_filesystem_tunnel_id
FILESYSTEM_CONTROL_PLANE_API_KEY=sk-replace_with_filesystem_runtime_api_key

# Absolute path to the only host directory exposed to the MCP server.
FILESYSTEM_HOST_PATH=/absolute/path/to/allowed/directory
